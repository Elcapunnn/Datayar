# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Optional API key for OpenRouter models (Claude, Llama, DeepSeek, Mistral, GPT, etc.)
# Get your key at https://openrouter.ai/keys and add it in AI Studio Settings -> Secrets or .env
OPENROUTER_API_KEY=

# OPENROUTER_MODEL: The model to use on OpenRouter (e.g. "deepseek/deepseek-chat", "anthropic/claude-3.5-sonnet", "meta-llama/llama-3.3-70b-instruct")
# Default if left empty: "deepseek/deepseek-chat"
OPENROUTER_MODEL=deepseek/deepseek-chat

# GROQ_API_KEY: Free-tier API key (no credit card) from https://console.groq.com/keys
# Free tier renews daily: gpt-oss-120b = 1,000 req/day, llama-3.1-8b-instant = 14,400 req/day
GROQ_API_KEY=

# GROQ_MODEL: The model to use on Groq.
# Default if left empty: "openai/gpt-oss-120b"
# For maximum daily requests use "llama-3.1-8b-instant" (14,400 req/day).
GROQ_MODEL=openai/gpt-oss-120b

# MISTRAL_API_KEY: Free Experiment tier key from https://console.mistral.ai/api-keys (SMS verification, no card)
# ~1B tokens/month, 1 request/sec limit
MISTRAL_API_KEY=

# MISTRAL_MODEL: Model to use on Mistral. Default if left empty: "mistral-small-latest"
MISTRAL_MODEL=mistral-small-latest

# NVIDIA_API_KEY: Free prototyping API key (no credit card) from https://build.nvidia.com
# ~40 requests/min, no per-day cap. Works from regions/networks where Groq is blocked.
NVIDIA_API_KEY=

# NVIDIA_MODEL: The model to use on NVIDIA NIM (model list changes often; check build.nvidia.com).
# Default if left empty: "meta/llama-3.3-70b-instruct"
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

